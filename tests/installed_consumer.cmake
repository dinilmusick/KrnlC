set(prefix "${PROJECT_BUILD}/installed-test-root")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${PROJECT_BUILD}" --config "${CONFIG}" --prefix "${prefix}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "Cannot install KrnlC")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${PROJECT_SOURCE}/examples/consumer" -B "${PROJECT_BUILD}/external-consumer" -DCMAKE_PREFIX_PATH=${prefix} "-DCMAKE_C_FLAGS=${CONSUMER_C_FLAGS}" "-DCMAKE_EXE_LINKER_FLAGS=${CONSUMER_LINKER_FLAGS}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "External consumer configure failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${PROJECT_BUILD}/external-consumer" --config "${CONFIG}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "External consumer build failed")
endif()
set(exe "${PROJECT_BUILD}/external-consumer/krnlc_consumer")
if(WIN32)
 set(exe "${exe}.exe")
endif()
if(CONFIG AND EXISTS "${PROJECT_BUILD}/external-consumer/${CONFIG}/krnlc_consumer${CMAKE_EXECUTABLE_SUFFIX}")
 set(exe "${PROJECT_BUILD}/external-consumer/${CONFIG}/krnlc_consumer${CMAKE_EXECUTABLE_SUFFIX}")
endif()
if(WIN32 AND CONFIG AND EXISTS "${PROJECT_BUILD}/external-consumer/${CONFIG}/krnlc_consumer.exe")
 set(exe "${PROJECT_BUILD}/external-consumer/${CONFIG}/krnlc_consumer.exe")
endif()
execute_process(COMMAND "${exe}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "External consumer execution failed")
endif()
